# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Apenas a URL e a chave pública (anon/publishable) ficam no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: caminho base do GitHub Pages. O padrão de build é /resenha/.
# Para domínio próprio na raiz, use /.
# VITE_BASE_PATH=/
